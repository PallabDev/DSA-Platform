<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard | AlgoFlow</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
</head>
<body>
  <div class="app">
    <nav class="navbar">
      <div class="nav-brand">
        <svg width="24" height="24" viewBox="0 0 72 72" fill="none">
          <rect x="8" y="12" width="56" height="48" rx="3" stroke="#5C3317" stroke-width="2.5" fill="none"/>
          <path d="M22 30L14 38L22 46" stroke="#E8941A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M50 30L58 38L50 46" stroke="#E8941A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M38 26L32 48" stroke="#8B4513" stroke-width="2.5" stroke-linecap="round"/>
        </svg>
        <span>AlgoFlow</span>
      </div>
      <div class="nav-user">
        <span id="greeting" class="greeting-text"></span>
        <div class="mode-switcher">
          <button class="mode-btn active" data-mode="30" onclick="switchMode('30')">30-Day</button>
          <button class="mode-btn" data-mode="60" onclick="switchMode('60')">60-Day</button>
        </div>
        <button class="btn-reset" onclick="resetProgress()" title="Reset Progress">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M1 4v6h6M23 20v-6h-6"/>
            <path d="M20.49 9A9 9 0 005.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 013.51 15"/>
          </svg>
        </button>
      </div>
    </nav>

    <div class="dashboard">
      <div class="progress-bar-container">
        <div class="progress-info">
          <span>Overall Progress</span>
          <span id="progressPercent">0%</span>
        </div>
        <div class="progress-track">
          <div class="progress-fill" id="progressFill"></div>
        </div>
        <div class="progress-stats">
          <span id="solvedCount">0 / 0 solved</span>
          <span id="dayStatus">Day 1</span>
        </div>
      </div>

      <div class="tab-bar">
        <button class="tab active" data-tab="today" onclick="switchTab('today')">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>
          </svg>
          Today
        </button>
        <button class="tab" data-tab="upcoming" onclick="switchTab('upcoming')">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
          Upcoming
        </button>
        <button class="tab" data-tab="all" onclick="switchTab('all')">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/>
          </svg>
          Full Roadmap
        </button>
      </div>

      <div class="tab-content active" id="tab-today"></div>
      <div class="tab-content" id="tab-upcoming"></div>
      <div class="tab-content" id="tab-all"></div>
    </div>
  </div>

  <script>
    const roadmapData = <%- JSON.stringify(roadmap) %>;
    const allProblems = <%- JSON.stringify(allProblems) %>;
    const currentMode = '<%- mode %>';

    let progress = JSON.parse(localStorage.getItem('dsa_progress') || '{}');
    let username = localStorage.getItem('dsa_username') || 'Coder';
    let startDate = localStorage.getItem('dsa_start_date') || new Date().toISOString().split('T')[0];
    let activeMode = localStorage.getItem('dsa_mode') || currentMode;

    document.getElementById('greeting').textContent = 'Welcome, ' + username;

    function getMaxDays() {
      return activeMode === '60' ? 60 : 30;
    }

    function getCurrentDay() {
      const start = new Date(startDate);
      const now = new Date();
      const diff = Math.floor((now - start) / (1000 * 60 * 60 * 24)) + 1;
      return Math.max(1, Math.min(diff, getMaxDays()));
    }

    function getDayStatus(dayNum) {
      const currentDay = getCurrentDay();
      if (dayNum < currentDay) return 'past';
      if (dayNum === currentDay) return 'today';
      return 'future';
    }

    function updateProgress() {
      const total = roadmapData.total_problems;
      const solved = Object.values(progress).filter(v => v).length;
      const pct = total > 0 ? Math.round((solved / total) * 100) : 0;
      document.getElementById('progressPercent').textContent = pct + '%';
      document.getElementById('progressFill').style.width = pct + '%';
      document.getElementById('solvedCount').textContent = solved + ' / ' + total + ' solved';
      document.getElementById('dayStatus').textContent = 'Day ' + getCurrentDay() + ' of ' + getMaxDays();
    }

    function toggleProblem(id) {
      progress[id] = !progress[id];
      localStorage.setItem('dsa_progress', JSON.stringify(progress));
      updateProgress();
      renderAll();
    }

    function renderProblemCard(problem) {
      const isSolved = progress[problem.id] || false;
      const statusClass = isSolved ? 'solved' : '';
      const levelClass = (problem.level || '').toLowerCase();
      const companies = (problem.companyTags || []).slice(0, 3);

      return '<div class="problem-card ' + statusClass + '">' +
        '<div class="problem-header">' +
          '<label class="checkbox-wrap">' +
            '<input type="checkbox" ' + (isSolved ? 'checked' : '') + ' onchange="toggleProblem(\'' + problem.id + '\')">' +
            '<span class="checkmark"></span>' +
          '</label>' +
          '<div class="problem-info">' +
            '<a href="' + (problem.leetcode || '#') + '" target="_blank" class="problem-name">' + problem.name + '</a>' +
          '</div>' +
          '<div class="problem-meta">' +
            '<span class="diff-tag ' + levelClass + '">' + (problem.level || '') + '</span>' +
            (problem.avgTime ? '<span class="avg-time">' + problem.avgTime + '</span>' : '') +
          '</div>' +
        '</div>' +
        (companies.length > 0 ?
          '<div class="problem-tags">' +
            companies.map(c => '<span class="company-tag">' + c + '</span>').join('') +
          '</div>' : '') +
      '</div>';
    }

    function renderToday() {
      const currentDay = getCurrentDay();
      const dayData = roadmapData.days.find(d => d.day === currentDay) || roadmapData.days[0];
      if (!dayData) return;

      let html = '<div class="section-header">' +
        '<div>' +
          '<h2 class="section-title">Day ' + dayData.day + ': ' + dayData.topic + '</h2>' +
          '<p class="section-desc">' + (dayData.description || '') + '</p>' +
        '</div>' +
        '<span class="badge badge-today">Today</span>' +
      '</div>' +
      '<div class="focus-area"><strong>Focus:</strong> ' + (dayData.focus_area || '') + '</div>' +
      '<div class="problems-grid">';

      (dayData.problems || []).forEach(p => {
        html += renderProblemCard(p);
      });

      html += '</div>';
      document.getElementById('tab-today').innerHTML = html;
      animateCards('#tab-today .problem-card');
    }

    function renderUpcoming() {
      const currentDay = getCurrentDay();
      let html = '';

      if (currentDay < getMaxDays()) {
        const nextDay = roadmapData.days.find(d => d.day === currentDay + 1);
        if (nextDay) {
          html += '<div class="section-header">' +
            '<div>' +
              '<h2 class="section-title">Day ' + nextDay.day + ': ' + nextDay.topic + '</h2>' +
              '<p class="section-desc">' + (nextDay.description || '') + '</p>' +
            '</div>' +
            '<span class="badge badge-upcoming">Next</span>' +
          '</div>' +
          '<div class="focus-area"><strong>Focus:</strong> ' + (nextDay.focus_area || '') + '</div>' +
          '<div class="problems-grid">';

          (nextDay.problems || []).forEach(p => {
            html += renderProblemCard(p);
          });
          html += '</div>';
        }
      }

      const backlogDays = roadmapData.days.filter(d => d.day < currentDay && !isDayComplete(d));
      if (backlogDays.length > 0) {
        html += '<div class="section-header backlog-header">' +
          '<div>' +
            '<h2 class="section-title">Backlog</h2>' +
            '<p class="section-desc">Unsolved problems from previous days</p>' +
          '</div>' +
        '</div>';

        backlogDays.forEach(day => {
          const unsolved = (day.problems || []).filter(p => !progress[p.id]);
          if (unsolved.length === 0) return;
          html += '<div class="backlog-day">' +
            '<h3 class="backlog-day-title">Day ' + day.day + ': ' + day.topic + ' <span class="backlog-count">' + unsolved.length + ' pending</span></h3>' +
            '<div class="problems-grid">';

          unsolved.forEach(p => {
            html += renderProblemCard(p);
          });
          html += '</div></div>';
        });
      }

      if (!html) {
        html = '<div class="empty-state"><p>All caught up! No pending problems.</p></div>';
      }

      document.getElementById('tab-upcoming').innerHTML = html;
      animateCards('#tab-upcoming .problem-card');
    }

    function isDayComplete(day) {
      return (day.problems || []).every(p => progress[p.id]);
    }

    function renderAll() {
      let html = '<div class="roadmap-list">';

      roadmapData.days.forEach(day => {
        const dayComplete = isDayComplete(day);
        const dayStatus = getDayStatus(day.day);
        const solvedCount = (day.problems || []).filter(p => progress[p.id]).length;
        const totalProblems = (day.problems || []).length;
        const statusIcon = dayComplete ? '&#10003;' : solvedCount + '/' + totalProblems;
        let statusCls = dayComplete ? 'day-complete' : '';
        if (dayStatus === 'today') statusCls += ' day-current';

        html += '<div class="roadmap-day ' + statusCls + '">' +
          '<div class="day-header" onclick="toggleDay(this)">' +
            '<div class="day-left">' +
              '<span class="day-num">' + day.day + '</span>' +
              '<div class="day-info">' +
                '<span class="day-topic">' + day.topic + '</span>' +
                '<span class="day-meta">' + totalProblems + ' problems' + (day.focus_area ? ' &middot; ' + day.focus_area : '') + '</span>' +
              '</div>' +
            '</div>' +
            '<div class="day-right">' +
              '<span class="day-progress-badge ' + (dayComplete ? 'complete' : '') + '">' + statusIcon + '</span>' +
              '<svg class="chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 9l6 6 6-6"/></svg>' +
            '</div>' +
          '</div>' +
          '<div class="day-problems">';

        (day.problems || []).forEach(p => {
          html += renderProblemCard(p);
        });

        html += '</div></div>';
      });

      html += '</div>';
      document.getElementById('tab-all').innerHTML = html;
      animateCards('#tab-all .problem-card');
    }

    function toggleDay(header) {
      const dayEl = header.closest('.roadmap-day');
      const wasExpanded = dayEl.classList.contains('expanded');
      dayEl.classList.toggle('expanded');

      // Animate problems inside
      if (!wasExpanded) {
        const cards = dayEl.querySelectorAll('.problem-card');
        gsap.fromTo(cards, { opacity: 0, y: 8 }, { opacity: 1, y: 0, duration: 0.3, stagger: 0.05, ease: 'power2.out' });
      }
    }

    function switchTab(tab) {
      document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
      document.querySelector('[data-tab="' + tab + '"]').classList.add('active');
      document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
      document.getElementById('tab-' + tab).classList.add('active');

      if (tab === 'today') renderToday();
      if (tab === 'upcoming') renderUpcoming();
      if (tab === 'all') renderAll();
    }

    function switchMode(mode) {
      activeMode = mode;
      localStorage.setItem('dsa_mode', mode);
      window.location.href = '/dashboard?mode=' + mode;
    }

    function resetProgress() {
      if (confirm('Reset all progress? This cannot be undone.')) {
        progress = {};
        localStorage.setItem('dsa_progress', '{}');
        updateProgress();
        renderAll();
        switchTab('today');
      }
    }

    function animateCards(selector) {
      const cards = document.querySelectorAll(selector);
      if (cards.length === 0) return;
      gsap.fromTo(cards, { opacity: 0, y: 12 }, { opacity: 1, y: 0, duration: 0.35, stagger: 0.04, ease: 'power2.out' });
    }

    // Init mode switcher UI
    document.querySelectorAll('.mode-btn').forEach(btn => {
      if (btn.dataset.mode === activeMode) {
        btn.classList.add('active');
      } else {
        btn.classList.remove('active');
      }
    });

    // Page load animation
    gsap.fromTo('.navbar', { y: -20, opacity: 0 }, { y: 0, opacity: 1, duration: 0.4, ease: 'power2.out' });
    gsap.fromTo('.progress-bar-container', { y: 16, opacity: 0 }, { y: 0, opacity: 1, duration: 0.4, delay: 0.1, ease: 'power2.out' });
    gsap.fromTo('.tab-bar', { y: 16, opacity: 0 }, { y: 0, opacity: 1, duration: 0.4, delay: 0.2, ease: 'power2.out' });

    updateProgress();
    switchTab('today');
  </script>
</body>
</html>
